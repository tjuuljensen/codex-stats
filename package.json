{
  "name": "codex-stats",
  "author": "Maol-1997",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maol-1997/codex-stats"
  },
  "displayName": "Codex Stats",
  "description": "Monitor your ChatGPT/Codex Stats and rate limits",
  "version": "1.1.0",
  "publisher": "tjuuljensen",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/blossom.dark.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "codex-blossom": {
        "description": "Codex Blossom Icon",
        "default": {
          "fontPath": "resources/codex-icon.woff",
          "fontCharacter": "\\e900"
        }
      }
    },
    "commands": [
      {
        "command": "codex-usage.refresh",
        "title": "Refresh Codex Stats"
      },
      {
        "command": "codex-usage.login",
        "title": "Login to Codex"
      },
      {
        "command": "codex-usage.reconnect",
        "title": "Reconnect Codex App Server"
      },
      {
        "command": "codex-usage.showLogs",
        "title": "Show Codex Stats Logs"
      }
    ],
    "configuration": {
      "title": "Codex Stats",
      "properties": {
        "codexUsage.updateInterval": {
          "type": "number",
          "default": 300,
          "description": "Update interval in seconds (default: 300 = 5 minutes)"
        },
        "codexUsage.showNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Show notifications when rate limits are high"
        },
        "codexUsage.displayMode": {
          "type": "string",
          "enum": [
            "remaining",
            "used"
          ],
          "default": "remaining",
          "description": "Display quota as percentage remaining or percentage used in the status bar and tooltip."
        },
        "codexUsage.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Path to the Codex CLI executable."
        },
        "codexUsage.appServerArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments passed to `codex app-server`."
        },
        "codexUsage.requestTimeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "JSON-RPC request timeout in milliseconds."
        },
        "codexUsage.debug": {
          "type": "boolean",
          "default": false,
          "description": "Write diagnostic logs to the Codex Stats output channel."
        },
        "codexUsage.logRawJsonRpc": {
          "type": "boolean",
          "default": false,
          "description": "Log raw local JSON-RPC messages. This may include account metadata but never sends it externally."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "vscode:publish": "vsce publish",
    "compile": "tsc -p ./",
    "vscode:package": "vsce package",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^8.28.0",
    "typescript": "^4.9.3"
  }
}
